---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Silver RPG Master",
  description = "Ferramentas para conduzir sessões de RPG de mesa.",
} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111411" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
