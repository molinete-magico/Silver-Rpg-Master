---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";
const user = Astro.locals.user;
if (!user) return Astro.redirect("/entrar");
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: memberships } = await supabase.from("room_members")
  .select("role, joined_at, rooms(id, name, room_type, status, discord_invite_url, created_at)")
  .eq("user_id", user.id).order("joined_at", { ascending: false });
const error = Astro.url.searchParams.get("erro");
---
<SiteLayout title="Suas salas — Silver RPG Master">
  <main class="workspace">
    <header class="workspace-header">
      <a class="brand" href="/"><span class="brand-mark">S.</span><span>SILVER <span class="muted">/</span> RPG MASTER</span></a>
      <nav><a href="/salas">Salas</a>{user.app_metadata.global_role === "admin" && <a href="/admin">Administração</a>}<form action="/api/auth/logout" method="POST"><button class="quiet-button" type="submit">Sair</button></form></nav>
    </header>
    <section class="content">
      <p class="eyebrow">Área de jogo</p><h1>Suas salas<span>.</span></h1>
      <p class="muted welcome">Conectado como {user.email ?? "participante"}.</p>
      {error && <p class="error" role="alert">Não foi possível concluir a operação. Confira os dados e tente novamente.</p>}
      <div class="room-grid">
        <section class="panel"><p class="eyebrow">Nova mesa</p><h2>Criar uma sala</h2>
          <form action="/api/rooms/create" method="POST">
            <label for="name">Nome da sala</label><input id="name" name="name" maxlength="80" required placeholder="Ex.: A última vigília" />
            <label for="room_type">Duração</label><select id="room_type" name="room_type"><option value="permanent">Permanente</option><option value="temporary">Temporária</option></select>
            <label for="discord_invite_url">Convite do Discord <span>(opcional)</span></label><input id="discord_invite_url" name="discord_invite_url" type="url" placeholder="https://discord.gg/…" />
            <button class="button button-primary" type="submit">Criar sala <span aria-hidden="true">→</span></button>
          </form>
          <p class="panel-note">Ao criar a sala, você se torna automaticamente o mestre.</p>
        </section>
        <section class="panel"><p class="eyebrow">Entrar em uma mesa</p><h2>Usar convite</h2>
          <form action="/api/rooms/join" method="POST">
            <label for="code">Código da sala</label><input id="code" name="code" minlength="64" maxlength="64" pattern="[a-fA-F0-9]{64}" required placeholder="Código recebido do mestre" />
            <button class="button" type="submit">Entrar na sala <span aria-hidden="true">→</span></button>
          </form>
          <p class="panel-note">O código é de uso limitado e pode expirar.</p>
        </section>
      </div>
      <div class="rooms-heading"><h2>Mesas disponíveis</h2><span>{memberships?.length ?? 0} salas</span></div>
      {(!memberships || memberships.length === 0) ? <div class="empty-state"><span>—</span><h3>Nenhuma sala por enquanto.</h3><p>Crie sua própria mesa ou entre usando um convite.</p></div> : (
        <div class="room-list">{memberships.map((membership) => {
          const room = Array.isArray(membership.rooms) ? membership.rooms[0] : membership.rooms;
          if (!room) return null;
          return <a class="room-row" href={`/salas/${room.id}`}>
            <span class="room-type">{room.room_type === "permanent" ? "PERMANENTE" : "TEMPORÁRIA"}</span>
            <span class="room-name">{room.name}<small>{membership.role === "gm" ? "Mestre" : "Participante"} · {room.status === "active" ? "Ativa" : "Encerrada"}</small></span>
            <span class="room-open">Abrir →</span>
          </a>;
        })}</div>
      )}
    </section>
  </main>
</SiteLayout>
<style>
.workspace{min-height:100vh}.workspace-header{height:76px;padding-inline:max(24px,calc((100vw - 1120px)/2));display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}nav{display:flex;align-items:center;gap:24px}nav a,.quiet-button{color:var(--muted);font-size:12px}nav a:hover,.quiet-button:hover{color:var(--text)}nav form{display:inline}.quiet-button{border:0;background:none;cursor:pointer}.content{width:min(100% - 48px,920px);margin:72px auto}h1{margin:14px 0 10px;font:700 clamp(42px,7vw,64px)/1 var(--display);letter-spacing:-.06em}h1 span{color:var(--accent)}.welcome{font-size:13px}.room-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:42px}.panel{border:1px solid var(--line);padding:24px;background:#151a16}.panel h2{margin:12px 0 22px;font:600 20px var(--display)}.panel form{display:grid;gap:10px}.panel label{margin-top:8px;color:#b7c0b6;font-size:12px;font-weight:600}.panel label span{color:var(--muted);font-weight:400}.panel input,.panel select{width:100%;height:43px;border:1px solid var(--line);border-radius:0;background:#171d18;color:var(--text);padding:0 11px;outline:none}.panel input:focus,.panel select:focus{border-color:var(--accent)}.panel button{margin-top:12px;justify-self:start}.panel-note{margin:18px 0 0;color:#829083;font-size:11px;line-height:1.7}.rooms-heading{display:flex;justify-content:space-between;align-items:baseline;margin-top:60px;border-bottom:1px solid var(--line);padding-bottom:13px}.rooms-heading h2{margin:0;font:600 17px var(--display)}.rooms-heading span{color:var(--muted);font:11px var(--mono)}.room-row{display:grid;grid-template-columns:130px 1fr auto;align-items:center;gap:15px;min-height:76px;border-bottom:1px solid #29312a}.room-type{color:#829083;font:10px var(--mono);letter-spacing:.08em}.room-name{font-size:14px;font-weight:600}.room-name small{display:block;margin-top:5px;color:var(--muted);font-size:11px;font-weight:400}.room-open{color:var(--accent-strong);font-size:12px}.empty-state{margin-top:20px;padding:30px;border:1px solid var(--line);background:#151a16}.empty-state>span{color:var(--accent);font:25px var(--mono)}.empty-state h3{margin:14px 0 7px;font:600 18px var(--display)}.empty-state p,.error{color:var(--muted);font-size:12px}.error{color:var(--danger)}@media(max-width:700px){.room-grid{grid-template-columns:1fr}.room-row{grid-template-columns:1fr auto}.room-type{display:none}}@media(max-width:520px){.content{width:calc(100% - 36px);margin-block:50px}.workspace-header{padding-inline:18px}nav{gap:12px}nav a{font-size:11px}}
</style>