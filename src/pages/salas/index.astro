---
import SiteLayout from "../../layouts/SiteLayout.astro";
const user = Astro.locals.user;
---
<SiteLayout title="Suas salas — Silver RPG Master">
  <main class="workspace">
    <header class="workspace-header">
      <a class="brand" href="/"><span class="brand-mark">S.</span><span>SILVER <span class="muted">/</span> RPG MASTER</span></a>
      <form action="/api/auth/logout" method="POST"><button class="quiet-button" type="submit">Sair</button></form>
    </header>
    <section class="content">
      <p class="eyebrow">Área de jogo</p>
      <h1>Suas salas<span>.</span></h1>
      <p class="muted">Conectado como {user?.email ?? "participante"}.</p>
      <div class="empty-state">
        <span class="empty-mark">—</span>
        <h2>A mesa começa aqui.</h2>
        <p>As salas serão exibidas neste espaço. A criação e a entrada serão habilitadas assim que a estrutura segura de convites e participantes estiver configurada.</p>
      </div>
    </section>
  </main>
</SiteLayout>
<style>
  .workspace { min-height: 100vh; }
  .workspace-header { height: 76px; padding-inline: max(24px, calc((100vw - 1120px) / 2)); display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); }
  .quiet-button { border: 0; background: none; color: var(--muted); cursor: pointer; font-size: 12px; }
  .quiet-button:hover { color: var(--text); }
  .content { width: min(100% - 48px, 920px); margin: 82px auto; }
  h1 { margin: 14px 0 10px; font: 700 clamp(42px, 7vw, 64px)/1 var(--display); letter-spacing: -.06em; }
  h1 span { color: var(--accent); }
  .empty-state { margin-top: 58px; border: 1px solid var(--line); padding: 42px; max-width: 620px; background: #151a16; }
  .empty-mark { color: var(--accent); font: 28px var(--mono); }
  h2 { margin: 18px 0 10px; font: 600 22px var(--display); }
  .empty-state p { max-width: 470px; color: var(--muted); font-size: 13px; line-height: 1.8; }
  @media (max-width: 600px) { .empty-state { padding: 26px; } }
</style>
