---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabase/server";
const user = Astro.locals.user;
if (!user) return Astro.redirect("/entrar");
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const [{ data: rooms }, { data: memberships }] = await Promise.all([
  supabase.from("rooms").select("id, name, room_type, status, discord_invite_url, created_at").eq("status", "active").order("created_at", { ascending: false }),
  supabase.from("room_members").select("room_id, role").eq("user_id", user.id),
]);
const membershipByRoom = new Map((memberships ?? []).map((membership) => [membership.room_id, membership.role]));
const isMaster = ["admin", "master"].includes(String(user.app_metadata.global_role ?? ""));
const error = Astro.url.searchParams.get("erro");
---
<SiteLayout title="Sessões — Silver RPG Master">
  <main class="workspace">
    <header class="workspace-header">
      <a class="brand" href="/"><span class="brand-mark">S.</span><span>SILVER <span class="muted">/</span> RPG MASTER</span></a>
      <nav><a href="/salas">Sessões</a>{user.app_metadata.global_role === "admin" && <a href="/admin">Tokens</a>}<form action="/api/auth/logout" method="POST"><button class="quiet-button" type="submit">Sair</button></form></nav>
    </header>
    <section class="content">
      <p class="eyebrow">Área de jogo</p><h1>Sessões abertas<span>.</span></h1>
      <p class="muted welcome">Acesso compartilhado · {user.is_anonymous ? "participante" : "administrador"}</p>
      {error && <p class="error" role="alert">Não foi possível concluir a operação. Confira se a sessão continua aberta.</p>}
      {isMaster && <section class="panel">
        <p class="eyebrow">Mestre</p><h2>Abrir uma nova sessão</h2>
        <form action="/api/rooms/create" method="POST">
          <label for="name">Nome da sessão</label><input id="name" name="name" maxlength="80" required placeholder="Ex.: A última vigília" />
          <label for="room_type">Duração</label><select id="room_type" name="room_type"><option value="permanent">Permanente</option><option value="temporary">Temporária</option></select>
          <label for="discord_invite_url">Convite do Discord <span>(opcional)</span></label><input id="discord_invite_url" name="discord_invite_url" type="url" placeholder="https://discord.gg/…" />
          <button class="button button-primary" type="submit">Abrir sessão <span aria-hidden="true">→</span></button>
        </form>
      </section>}
      <div class="rooms-heading"><h2>Disponíveis para entrar</h2><span>{rooms?.length ?? 0} sessões</span></div>
      {(!rooms || rooms.length === 0) ? <div class="empty-state"><span>—</span><h3>Nenhuma sessão aberta.</h3><p>Quando o Mestre abrir uma sessão, ela aparecerá aqui para todos os participantes com token válido.</p></div> : (
        <div class="room-list">{rooms.map((room) => {
          const role = membershipByRoom.get(room.id);
          return <article class="room-row">
            <div><span class="room-type">{room.room_type === "permanent" ? "PERMANENTE" : "TEMPORÁRIA"}</span><h3>{room.name}</h3><small>{role === "gm" ? "Mestre" : role === "player" ? "Você já participa" : "Sessão aberta"}</small></div>
            {role ? <a class="room-open" href={`/salas/${room.id}`}>Abrir →</a> : <form action="/api/rooms/join" method="POST"><input type="hidden" name="room_id" value={room.id} /><button class="room-open" type="submit">Entrar →</button></form>}
          </article>;
        })}</div>
      )}
    </section>
  </main>
</SiteLayout>
<style>
.workspace{min-height:100vh}.workspace-header{height:76px;padding-inline:max(24px,calc((100vw - 1120px)/2));display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}nav{display:flex;align-items:center;gap:24px}nav a,.quiet-button{color:var(--muted);font-size:12px}nav a:hover,.quiet-button:hover{color:var(--text)}nav form{display:inline}.quiet-button{border:0;background:none;cursor:pointer}.content{width:min(100% - 48px,920px);margin:72px auto}h1{margin:14px 0 10px;font:700 clamp(42px,7vw,64px)/1 var(--display);letter-spacing:-.06em}h1 span{color:var(--accent)}.welcome{font-size:13px}.panel{margin-top:38px;border:1px solid var(--line);padding:24px;background:#151a16}.panel h2{margin:12px 0 22px;font:600 20px var(--display)}.panel form{display:grid;gap:10px;max-width:520px}.panel label{margin-top:8px;color:#b7c0b6;font-size:12px;font-weight:600}.panel label span{color:var(--muted);font-weight:400}.panel input,.panel select{width:100%;height:43px;border:1px solid var(--line);background:#171d18;color:var(--text);padding:0 11px}.panel button{margin-top:12px;justify-self:start}.rooms-heading{display:flex;justify-content:space-between;align-items:baseline;margin-top:60px;border-bottom:1px solid var(--line);padding-bottom:13px}.rooms-heading h2{margin:0;font:600 17px var(--display)}.rooms-heading span{color:var(--muted);font:11px var(--mono)}.room-row{display:flex;justify-content:space-between;align-items:center;gap:20px;min-height:82px;border-bottom:1px solid #29312a}.room-type{color:#829083;font:10px var(--mono);letter-spacing:.08em}.room-row h3{margin:7px 0 4px;font:600 15px var(--display)}.room-row small{color:var(--muted);font-size:11px}.room-open{display:inline-block;border:0;background:none;color:var(--accent-strong);font-size:12px;cursor:pointer;text-decoration:none}.empty-state{margin-top:20px;padding:30px;border:1px solid var(--line);background:#151a16}.empty-state>span{color:var(--accent);font:25px var(--mono)}.empty-state h3{margin:14px 0 7px;font:600 18px var(--display)}.empty-state p,.error{color:var(--muted);font-size:12px}.error{color:var(--danger)}@media(max-width:520px){.content{width:calc(100% - 36px);margin-block:50px}.workspace-header{padding-inline:18px}nav{gap:12px}nav a{font-size:11px}}
</style>
