---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ResourceBoard from "../../components/ResourceBoard";
import { createSupabaseServerClient } from "../../lib/supabase/server";
const user = Astro.locals.user;
if (!user) return Astro.redirect("/entrar");
const roomId = Astro.params.id ?? "";
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const [{ data: room }, { data: membership }] = await Promise.all([
  supabase.from("rooms").select("id, name, room_type, status, discord_invite_url, expires_at").eq("id", roomId).maybeSingle(),
  supabase.from("room_members").select("role").eq("room_id", roomId).eq("user_id", user.id).maybeSingle(),
]);
if (!room || !membership) return Astro.redirect("/salas");
const { data: members } = await supabase.from("room_members").select("user_id, role, profiles(display_name)").eq("room_id", roomId);
const isGm = membership.role === "gm";
---
<SiteLayout title={`${room.name} — Silver RPG Master`}>
  <main class="room-page">
    <header class="room-header">
      <a class="brand" href="/salas"><span class="brand-mark">S.</span><span>SILVER <span class="muted">/</span> RPG MASTER</span></a>
      <div class="room-actions">{room.discord_invite_url && <a class="discord" href={room.discord_invite_url} target="_blank" rel="noreferrer">Discord ↗</a>}<a href="/salas">Todas as salas</a></div>
    </header>
    <section class="room-content">
      <div class="room-title">
        <div><p class="eyebrow">{room.room_type === "permanent" ? "Sala permanente" : "Sala temporária"} · {isGm ? "Mestre" : "Participante"}</p><h1>{room.name}</h1></div>
        <span class={room.status === "active" ? "list-status active" : "list-status closed"}>{room.status === "active" ? "Em andamento" : "Encerrada"}</span>
      </div>
      {room.status === "closed" ? <div class="closed-notice">Esta sala foi encerrada. Seus dados permanecem preservados.</div> : <ResourceBoard client:load roomId={room.id} userId={user.id} role={isGm ? "gm" : "player"} />}
      <section class="participants">
        <div class="participants-heading"><h2>Participantes</h2><span>{members?.length ?? 0}</span></div>
        <div class="member-list">
          {members?.map((member) => {
            const profile = Array.isArray(member.profiles) ? member.profiles[0] : member.profiles;
            return <div class="member-row"><span>{profile?.display_name || "Participante"}</span><small>{member.role === "gm" ? "Mestre" : "Jogador"}</small></div>;
          })}
        </div>
      </section>
      {isGm && room.status === "active" && <section class="room-invite">
        <div><p class="eyebrow">Acesso à mesa</p><h2>Convidar participante</h2><p>O código permite uma entrada e expira em sete dias.</p></div>
        <form id="room-invite-form"><input type="hidden" name="room_id" value={room.id} /><button class="button" type="submit">Gerar convite</button></form>
        <div id="room-invite-result" hidden aria-live="polite"></div>
        <script>
          const form = document.querySelector<HTMLFormElement>("#room-invite-form");
          const result = document.querySelector<HTMLDivElement>("#room-invite-result");
          form?.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (!form || !result) return;
            const button = form.querySelector("button");
            if (button) button.disabled = true;
            try {
              const response = await fetch("/api/rooms/invitations", { method: "POST", body: new FormData(form) });
              const payload = await response.json();
              if (!response.ok || !payload.code) throw new Error(payload.error ?? "Não foi possível gerar o convite.");
              result.hidden = false;
              result.replaceChildren();
              const code = document.createElement("code");
              code.textContent = payload.code;
              const copy = document.createElement("button");
              copy.type = "button";
              copy.className = "button";
              copy.textContent = "Copiar";
              copy.addEventListener("click", async () => {
                await navigator.clipboard.writeText(payload.code);
                copy.textContent = "Copiado";
              });
              result.append(code, copy);
            } catch (cause) {
              result.hidden = false;
              result.textContent = cause instanceof Error ? cause.message : "Falha ao gerar convite.";
            } finally {
              if (button) button.disabled = false;
            }
          });
        </script>
      </section>}
      {isGm && room.status === "active" && <form class="close-room" action="/api/rooms/close" method="POST" onsubmit="return confirm('Encerrar esta sala?')">
        <input type="hidden" name="room_id" value={room.id} /><button class="close-button" type="submit">Encerrar sala</button>
      </form>}
    </section>
  </main>
</SiteLayout>
<style>
.room-page{min-height:100vh}.room-header{height:76px;padding-inline:max(24px,calc((100vw - 1120px)/2));display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.room-actions{display:flex;align-items:center;gap:22px}.room-actions a{color:var(--muted);font-size:12px}.room-actions .discord{color:var(--accent-strong)}.room-content{width:min(100% - 48px,1040px);margin:58px auto 90px}.room-title{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:42px}h1{margin:12px 0 0;font:700 clamp(36px,6vw,58px)/1 var(--display);letter-spacing:-.06em}.list-status{padding:7px 10px;color:var(--accent-strong);border:1px solid var(--line);font:10px var(--mono);text-transform:uppercase;letter-spacing:.08em}.list-status.closed{color:var(--danger)}.closed-notice{border:1px solid var(--line);padding:20px;color:var(--muted);font-size:13px}.participants{margin-top:42px;border-top:1px solid var(--line)}.participants-heading{display:flex;justify-content:space-between;align-items:baseline;padding-block:18px 10px}.participants-heading h2,.room-invite h2{margin:0;font:600 16px var(--display)}.participants-heading span{color:var(--muted);font:11px var(--mono)}.member-row{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #29312a;font-size:12px}.member-row small{color:var(--muted)}.room-invite{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:20px;margin-top:38px;border:1px solid var(--line);padding:22px;background:#151a16}.room-invite h2{margin:8px 0}.room-invite p:not(.eyebrow){margin:0;color:var(--muted);font-size:11px}#room-invite-result{display:flex;width:100%;align-items:center;flex-wrap:wrap;gap:12px}#room-invite-result code{flex:1;min-width:220px;padding:12px;background:#101410;color:var(--accent-strong);font:11px var(--mono);overflow-wrap:anywhere}.close-room{margin-top:24px}.close-button{border:0;padding:0;background:none;color:var(--danger);font-size:11px;cursor:pointer}@media(max-width:520px){.room-header{padding-inline:18px}.room-actions{gap:12px}.room-content{width:calc(100% - 36px);margin-top:40px}.room-title{align-items:start;flex-direction:column}}
</style>
