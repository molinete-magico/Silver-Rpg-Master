---
import SiteLayout from "../layouts/SiteLayout.astro";
const motivo = Astro.url.searchParams.get("motivo");
const erro = Astro.url.searchParams.get("erro");
---
<SiteLayout title="Entrar — Silver RPG Master">
  <main class="auth-page">
    <a class="brand" href="/"><span class="brand-mark">S.</span><span>SILVER <span class="muted">/</span> RPG MASTER</span></a>
    <section class="auth-panel">
      <p class="eyebrow">Acesso privado</p>
      <h1>Uma mesa.<br />Um código.</h1>
      <p class="muted description">Insira o token compartilhado que recebeu para entrar. Não é necessário criar conta, informar e-mail ou escolher senha.</p>
      {erro === "token" && <p class="notice" role="alert">Token inválido ou revogado. Confira o código e tente novamente.</p>}
      {erro === "revogado" && <p class="notice" role="alert">Seu acesso foi revogado. Peça um novo token ao administrador.</p>}
      {motivo === "anonimo" && <p class="notice" role="alert">O acesso temporário ainda não está habilitado no Supabase. O administrador precisa ativar os logins anônimos.</p>}
      {motivo === "configuracao" && <p class="notice" role="alert">A autenticação ainda não foi configurada neste ambiente.</p>}
      <form action="/api/auth/redeem" method="POST">
        <label for="code">Token de acesso</label>
        <input id="code" name="code" type="text" inputmode="text" autocomplete="off" minlength="64" maxlength="64" pattern="[a-fA-F0-9]{64}" placeholder="Cole seu token de acesso" required />
        <button class="button button-primary submit" type="submit">Entrar na mesa <span aria-hidden="true">→</span></button>
      </form>
      <details class="admin-login">
        <summary>Acesso administrativo</summary>
        <form action="/api/auth/login" method="POST">
          <label for="email">E-mail do administrador</label>
          <input id="email" name="email" type="email" autocomplete="username" required />
          <label for="password">Senha</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required />
          <button class="button submit" type="submit">Entrar como administrador</button>
        </form>
      </details>
      <a class="back-link" href="/">← Voltar ao início</a>
    </section>
  </main>
</SiteLayout>
<style>
  .auth-page { min-height: 100vh; width: min(100% - 48px, 1120px); margin: auto; padding-block: 34px; }
  .auth-panel { width: min(100%, 430px); margin: clamp(70px, 12vh, 130px) auto 60px; }
  h1 { margin: 18px 0 12px; font: 700 43px/1.08 var(--display); letter-spacing: -.055em; }
  .description { margin-bottom: 28px; font-size: 14px; line-height: 1.8; }
  form { display: grid; gap: 10px; }
  label { margin-top: 9px; color: #b7c0b6; font-size: 12px; font-weight: 600; }
  input { width: 100%; height: 46px; border: 1px solid var(--line); border-radius: 0; background: #171d18; color: var(--text); padding: 0 13px; outline: none; }
  input:focus { border-color: var(--accent); }
  .submit { width: 100%; margin-top: 15px; }
  .back-link { display: inline-block; margin-top: 30px; color: #8d9a8d; font-size: 12px; }
  .notice { padding: 11px 13px; margin-bottom: 18px; border-left: 2px solid var(--danger); background: #2a211f; color: #e1b2a8; font-size: 12px; line-height: 1.5; }
  .admin-login { margin-top: 32px; border-top: 1px solid var(--line); padding-top: 18px; }
  .admin-login summary { color: var(--muted); font-size: 12px; cursor: pointer; }
  .admin-login form { margin-top: 15px; }
  @media (max-width: 520px) { .auth-page { width: calc(100% - 36px); } .auth-panel { margin-top: 62px; } }
</style>
