---
import SiteLayout from "../layouts/SiteLayout.astro";
const motivo = Astro.url.searchParams.get("motivo");
const erro = Astro.url.searchParams.get("erro");
---
<SiteLayout title="Entrar — Silver RPG Master">
  <main class="auth-page">
    <a class="brand" href="/"><span class="brand-mark">S.</span><span>SILVER <span class="muted">/</span> RPG MASTER</span></a>
    <section class="auth-panel">
      <p class="eyebrow">Acesso privado</p>
      <h1>Bom ter você<br />de volta.</h1>
      <p class="muted description">Entre com sua conta para acessar suas salas.</p>
      {motivo === "configuracao" && <p class="notice" role="status">A autenticação ainda não foi configurada neste ambiente.</p>}
      {erro === "credenciais" && <p class="notice" role="alert">Não foi possível entrar com essas credenciais. Confira o e-mail e a senha.</p>}
      <form action="/api/auth/login" method="POST">
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
        <label for="password">Senha</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
        <button class="button button-primary submit" type="submit">Entrar <span aria-hidden="true">→</span></button>
      </form>
      <p class="invite-copy">Ainda não tem uma conta? <a href="/convite">Acesse com um convite</a>.</p>
      <a class="back-link" href="/">← Voltar ao início</a>
    </section>
  </main>
</SiteLayout>
<style>
  .auth-page { min-height: 100vh; width: min(100% - 48px, 1120px); margin: auto; padding-block: 34px; }
  .auth-panel { width: min(100%, 410px); margin: clamp(70px, 12vh, 130px) auto 60px; }
  h1 { margin: 18px 0 12px; font: 700 43px/1.08 var(--display); letter-spacing: -.055em; }
  .description { margin-bottom: 32px; font-size: 14px; }
  form { display: grid; gap: 10px; }
  label { margin-top: 9px; color: #b7c0b6; font-size: 12px; font-weight: 600; }
  input { width: 100%; height: 46px; border: 1px solid var(--line); border-radius: 0; background: #171d18; color: var(--text); padding: 0 13px; outline: none; }
  input:focus { border-color: var(--accent); }
  .submit { width: 100%; margin-top: 17px; }
  .invite-copy { margin-top: 26px; color: var(--muted); font-size: 12px; }
  .invite-copy a { color: var(--accent-strong); text-decoration: underline; text-underline-offset: 3px; }
  .back-link { display: inline-block; margin-top: 30px; color: #8d9a8d; font-size: 12px; }
  .notice { padding: 11px 13px; border-left: 2px solid var(--accent); background: #202721; color: #c6d2bf; font-size: 12px; line-height: 1.5; }
  @media (max-width: 520px) { .auth-page { width: calc(100% - 36px); } .auth-panel { margin-top: 82px; } }
</style>
