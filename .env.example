# Supabase — use a publishable key in browser-facing code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional server-only secrets. Never prefix these with PUBLIC_.
SUPABASE_SECRET_KEY=

# LiveKit — server-side only; never expose the API secret to the browser.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Set only when using a custom public origin.
APP_URL=
